licks as cvr\n\nfrom daily", "relation_name": "\"dev\".\"main\".\"fct_campaign_performance\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-04T13:39:02.547687Z", "completed_at": "2026-06-04T13:39:02.549054Z"}, {"name": "execute", "started_at": "2026-06-04T13:39:02.549275Z", "completed_at": "2026-06-04T13:39:02.549279Z"}], "thread_id": "Thread-3 (worker)", "execution_time": 0.003973960876464844, "adapter_response": {}, "message": null, "failures": null, "unique_id": "snapshot.adtech.snap_advertisers", "compiled": true, "compiled_code": "\n\n\n\nselect * from \"dev\".\"main\".\"stg_advertisers\"\n", "relation_name": "\"dev\".\"snapshots\".\"snap_advertisers\"", "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-04T13:39:02.527430Z", "completed_at": "2026-06-04T13:39:02.550277Z"}, {"name": "execute", "started_at": "2026-06-04T13:39:02.553571Z", "completed_at": "2026-06-04T13:39:02.553578Z"}], "thread_id": "Thread-4 (worker)", "execution_time": 0.0266268253326416, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.adtech.unique_stg_campaigns_campaign_id.72679b60d0", "compiled": true, "compiled_code": "\n    \n    \n\nselect\n    campaign_id as unique_field,\n    count(*) as n_records\n\nfrom \"dev\".\"main\".\"stg_campaigns\"\nwhere campaign_id is not null\ngroup by campaign_id\nhaving count(*) > 1\n\n\n", "relation_name": null, "batch_results": null}, {"status": "success", "timing": [{"name": "compile", "started_at": "2026-06-04T13:39:02.550484Z", "completed_at": "2026-06-04T13:39:02.559392Z"}, {"name": "execute", "started_at": "2026-06-04T13:39:02.562484Z", "completed_at": "2026-06-04T13:39:02.562492Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.016104459762573242, "adapter_response": {}, "message": null, "failures": null, "unique_id": "test.adtech.accepted_values_stg_advertisers_status__active__paused.b7cce8e0e2", "compiled":